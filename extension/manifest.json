{
  "manifest_version": 3,
  "name": "Choda Capture",
  "version": "0.1.0",
  "description": "Capture page text or a screenshot straight into choda-deck (inbox / task / conversation / knowledge).",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "webRequest", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/redact.js", "lib/selector.js", "lib/recorder.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Choda Capture"
  },
  "side_panel": { "default_path": "popup.html" },
  "options_page": "options.html"
}
